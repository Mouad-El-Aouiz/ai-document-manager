generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_MIGRATE")
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

enum DocumentStatus {
  PENDING
  PROCESSING
  INDEXED
  ERROR
}

enum DocumentVersionStatus {
  PENDING_UPLOAD
  UPLOADED
  SCANNING
  PROCESSING
  READY
  FAILED
}

enum OrganizationPlan {
  FREE
  PRO
  ENTERPRISE
}

model Organization {
  id        String           @id @default(uuid())
  name      String
  slug      String           @unique
  plan      OrganizationPlan @default(FREE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  users     User[]
  folders   Folder[]
  documents Document[]
  auditLogs AuditLog[]
  refreshTokens RefreshToken[]
  tags           Tag[]    
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  role           UserRole
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  folders          Folder[]          @relation("FolderCreatedBy")
  documents        Document[]        @relation("DocumentUploadedBy")
  versionsUploaded DocumentVersion[] @relation("VersionUploadedBy")
  auditLogs        AuditLog[]
  refreshTokens    RefreshToken[]

  @@index([organizationId])
}

model Folder {
  id             String    @id @default(uuid())
  name           String
  parentId       String?
  organizationId String
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  parent       Folder?      @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children     Folder[]     @relation("FolderHierarchy")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy    User         @relation("FolderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  documents    Document[]

  @@index([organizationId])
  @@index([parentId])
  @@index([organizationId, parentId])
}


model Document {
  id               String         @id @default(uuid())
  name             String
  folderId         String?
  organizationId   String
  uploadedById     String
  currentVersionId String?        @unique
  deletedAt        DateTime?
  metadata         Json? 
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  folder         Folder?           @relation(fields: [folderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  uploadedBy     User              @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currentVersion DocumentVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  versions       DocumentVersion[] @relation("AllVersions")
  chunks         DocumentChunk[]          
  tags           DocumentTag[]    

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([folderId])
}

model Tag {
  id             String        @id @default(uuid())
  organizationId String
  name           String        // Nom normalisé (minuscules, espaces compressés)
  color          String?       // Format hexadécimal (#RRGGBB)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    DocumentTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model DocumentTag {
  documentId String
  tagId      String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@index([tagId])
}

model DocumentVersion {
  id               String                 @id @default(uuid())
  documentId       String
  organizationId   String
  versionNumber    Int
  storageKey       String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  checksumSha256   String
  status           DocumentVersionStatus  @default(PENDING_UPLOAD)
  uploadedById     String
  createdAt        DateTime               @default(now())

  document     Document       @relation("AllVersions", fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  currentFor   Document?      @relation("CurrentVersion")
  uploadedBy   User           @relation("VersionUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  chunks       DocumentChunk[]

  @@unique([documentId, versionNumber])
  @@index([organizationId])
  @@index([documentId])
}

model DocumentChunk {
  id                String                     @id @default(uuid())
  documentId        String
  organizationId    String
  documentVersionId String?
  chunkIndex        Int
  content           String
  embedding         Unsupported("vector(768)")?
  embeddingModel    String
  createdAt         DateTime                   @default(now())

  document Document @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  version  DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([organizationId])
  @@index([documentVersionId])
}



model AuditLog {
  id             String   @id @default(uuid())
  action         String
  entityType     String
  entityId       String
  userId         String?
  organizationId String
  requestId      String?  // AJOUT
  ip             String?  // AJOUT
  metadata       Json?
  createdAt      DateTime @default(now())

  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId])
  @@index([action])
}

model RefreshToken {
  id             String    @id @default(uuid())
  userId         String
  organizationId String
  familyId       String
  tokenHash      String    @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  revokedAt      DateTime?
  userAgent      String?
  ip             String?
  createdAt      DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}