# ────────────────────────────────────────────────
# PostgreSQL
# ────────────────────────────────────────────────
POSTGRES_USER=aidm
POSTGRES_PASSWORD=change_me_in_dev
POSTGRES_DB=aidm

# Connexion runtime (application, soumise à la RLS)
DATABASE_URL=postgresql://aidm_app:change_me_app_in_dev@localhost:5432/aidm?schema=public

# Connexion migrations / seed / administration (superuser, bypass RLS)
DATABASE_URL_MIGRATE=postgresql://aidm:change_me_in_dev@localhost:5432/aidm?schema=public

# ────────────────────────────────────────────────
# Redis
# ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ────────────────────────────────────────────────
# Stockage objet (Silo — fork communautaire de MinIO)
# Les variables MINIO_* sont conservées par compatibilité.
# ────────────────────────────────────────────────
MINIO_ROOT_USER=aidm_admin
MINIO_ROOT_PASSWORD=change_me_in_dev
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_URL=http://localhost:9001
MINIO_BUCKET=aidm-documents