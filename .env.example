# ────────────────────────────────────────────────
# PostgreSQL
# ────────────────────────────────────────────────
POSTGRES_USER=aidm
POSTGRES_PASSWORD=change_me_in_dev
POSTGRES_DB=aidm
# Mot de passe du rôle applicatif aidm_app (soumis à la RLS)
APP_DB_PASSWORD=change_me_app_in_dev

# Connexions depuis l'hôte (pnpm dev sur ta machine)
DATABASE_URL=postgresql://aidm_app:change_me_app_in_dev@localhost:5433/aidm?schema=public
DATABASE_URL_MIGRATE=postgresql://aidm:change_me_in_dev@localhost:5433/aidm?schema=public

# ────────────────────────────────────────────────
# Redis
# ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ────────────────────────────────────────────────
# Stockage objet (Silo — fork MinIO)
# Depuis l'hôte (pnpm dev) : http://localhost:9000
# Depuis Docker : écrasé dans docker-compose.yml avec http://minio:9000
# ────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=aidm_admin
S3_SECRET_KEY=change_me_in_dev
S3_BUCKET=aidm-documents
S3_REGION=us-east-1
MINIO_ROOT_USER=aidm_admin
MINIO_ROOT_PASSWORD=change_me_in_dev

# ────────────────────────────────────────────────
# Auth
# ────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev_access_secret_that_is_at_least_32_chars_long
JWT_REFRESH_SECRET=dev_refresh_secret_that_is_at_least_32_chars_long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ────────────────────────────────────────────────
# API
# ────────────────────────────────────────────────
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=debug
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation,text/plain,text/markdown,text/csv,image/png,image/jpeg
MAX_FILE_SIZE_BYTES=104857600

# ────────────────────────────────────────────────
# Worker (rétention)
# ────────────────────────────────────────────────
PENDING_UPLOAD_TTL_HOURS=24
SOFT_DELETE_RETENTION_DAYS=30
RETENTION_FREE_VERSIONS=3
RETENTION_PRO_VERSIONS=10
RETENTION_ENTERPRISE_VERSIONS=50